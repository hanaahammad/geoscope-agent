(function($,Drupal,once){Drupal.behaviors.hds_earthdata_tables={attach:function(context,settings){once('viewsItemsPerPageSelect','.hds-advanced-table .pagination-row select[id^="edit-items-per-page"]',context).forEach(function(element){element.addEventListener("change",(event)=>{let paginationRowSelect=$(event.target);let newValue=paginationRowSelect.val();let topParent=paginationRowSelect.closest('.views-element-container');let parent=paginationRowSelect.closest('.hds-advanced-table');let button=parent.find('button.js-form-submit');let title=parent.find('h2').text();if(parent){let originalSelect=parent.find('.views-exposed-form .js-form-item-items-per-page select[id^="edit-items-per-page"]');if(originalSelect){originalSelect.val(newValue).prop('selected',true);originalSelect.trigger('change');button.trigger('click');}}$(context).on('ajaxComplete',function(event,xhr,settings){topParent.find('h2',context).text(title);});});});once('rowspanTableStriping','table.table.table-striped-rowspan',context).forEach(function(table,tableIndex){try{let tbody=table.tBodies[0];if(!tbody){console.warn(`Table at index ${tableIndex} does not have a <tbody>. Skipping.`);return;}let skip=0;let dark=false;for(let row of tbody.rows)try{if(skip===0){dark=!dark;let first_cell=row.cells[0];if(!first_cell){console.warn(`Row in table at index ${tableIndex} has no first cell. Skipping.`);continue;}let rowspan=first_cell.rowSpan;if(rowspan>1)skip=rowspan-1;row.classList.add((dark?'stripe-dark':'stripe-light'));}else{row.classList.add((dark?'stripe-dark':'stripe-light'));skip=skip-1;}}catch(rowError){console.error(`Error processing row at index ${row.rowIndex} in table at index ${tableIndex}: ${rowError.message}`);}}catch(tableError){console.error(`Error processing table at index ${tableIndex}: ${tableError.message}`);}});}};})(jQuery,Drupal,once);;
