(function($,Drupal,once){function addTopPadding(element,pixels){if(!(element instanceof Element)||typeof pixels!=='number'){console.warn("HDS Breadcrumbs addTopPadding: Invalid parameter(s).");return false;}try{let dataPaddingTop=element.dataset.originalTopPadding;if(!dataPaddingTop){const elComputedStyle=window.getComputedStyle(element);dataPaddingTop=parseInt(elComputedStyle.paddingTop)||0;element.dataset.originalTopPadding=String(dataPaddingTop);}else dataPaddingTop=parseInt(dataPaddingTop);const totalPadding=dataPaddingTop+pixels;element.setAttribute('style','padding-top: '+totalPadding+'px !important');return true;}catch(error){console.error('HDS Breadcrumbs addTopPadding: Failed to update padding.',error);return false;}}function getTopOfPageElement(){const topOfPageSelectors=['#page > .featured-top article.node--view-mode-hero .layout-bg-content-container','#page > .featured-top article.node--view-mode-hero .hero-gradient-black-to-carbon','#page > .featured-top article.node--view-mode-hero .dataset-hero-top','#main-wrapper'];for(const selector of topOfPageSelectors){const $element=$(selector);if($element.length&&$element.is(':visible'))return $element[0];}return null;}function addDynamicPadding(element,topOfPageElement){const breadcrumbNav=element.querySelector('nav.position-absolute');if(breadcrumbNav instanceof Element){const breadcrumbHeight=breadcrumbNav.offsetHeight;if(breadcrumbHeight>74){const extraHeight=breadcrumbHeight-74;return addTopPadding(topOfPageElement,extraHeight);}else return addTopPadding(topOfPageElement,0);}return false;}Drupal.behaviors.hds_earthdata_breadcrumbs={attach:function(context,settings){once('breadcrumbDynamicSpacing','#block-hds-earthdata-breadcrumbs',context).forEach(function(element){if($('body.node--type-storymap').length)return;const topOfPageElement=getTopOfPageElement();if(topOfPageElement){addDynamicPadding(element,topOfPageElement);window.addEventListener('resize',Drupal.debounce(()=>{addDynamicPadding(element,topOfPag