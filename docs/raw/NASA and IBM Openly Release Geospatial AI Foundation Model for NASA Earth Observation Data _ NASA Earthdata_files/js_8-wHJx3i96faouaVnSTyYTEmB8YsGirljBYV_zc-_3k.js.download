	</svg>`;function toggleMobileNav(){const body=document.body;if(mobileNavigation.classList.contains('open')){mobileNavigation.classList.remove('open');mobileNavButton.innerHTML=openIcon;body.classList.remove('overflow-hidden');}else{mobileNavigation.classList.add('open');mobileNavButton.innerHTML=closeIcon;window.scrollTo({top:0,behavior:"instant"});body.classList.add('overflow-hidden');}}mobileNavButton.addEventListener('click',toggleMobileNav);});document.addEventListener('DOMContentLoaded',function(){const menuItems=document.querySelectorAll('.drilldown li > a');menuItems.forEach((link)=>{const submenu=link.nextElementSibling;if(submenu&&submenu.classList.contains('nested')){const chevron=document.createElement('span');chevron.classList.add('chevron');chevron.innerHTML=`
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
          <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
        </svg>`;link.appendChild(chevron);}link.addEventListener('click',function(e){const submenu=this.nextElementSibling;const parentMenu=this.closest('ul.drilldown');if(submenu&&submenu.classList.contains('nested')){e.preventDefault();const activeSubmenus=parentMenu.querySelectorAll('.nested.active');activeSubmenus.forEach((activeSubmenu)=>{activeSubmenu.classList.remove('active');});const movedMenus=parentMenu.querySelectorAll('.menu.move-left');movedMenus.forEach((movedMenu)=>{movedMenu.classList.remove('move-left');});submenu.classList.add('active');submenu.parentNode.closest('ul').classList.add('move-left');if(!submenu.querySelector('.back-link')){const backLink=document.createElement('li');backLink.classList.add('back-link');backLink.innerHTML='<a href="#" class="drilldown-back"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">\n'+'  <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />\n'+'</svg>Back</a>';submenu.insertBefore(backLink,submenu.firstChild);backLink.addEventListener('click',function(e){e.preventDefault();submenu.classList.remove('active');const parentSubmenu=submenu.parentNode.closest('.nested');if(parentSubmenu)parentSubmenu.classList.add('active');const grandParentMenu=submenu.parentNode.closest('ul');if(grandParentMenu&&grandParentMenu.classList.contains('menu'))grandParentMenu.classList.remove('move-left');});}if(!submenu.querySelector('.current-parent')){const currentParent=document.createElement('li');currentParent.classList.add('current-parent');currentParent.innerHTML=`<a href="${this.href}" class="parent-link section-title">${this.textContent.trim()} <i class="hdsi hdsi-ui-arrow-line-right-circle-fill-opaque text-secondary me-auto"></i></a>`;submenu.insertBefore(currentParent,submenu.querySelector('.back-link').nextSibling);}if(submenu.querySelector('.section-title-with-icon')){const sectionTitle=submenu.querySelector('.section-title-with-icon');sectionTitle.innerHTML+=` <i class="hdsi hdsi-ui-arrow-line-right-circle-fill-opaque text-secondary ms-1 me-auto"></i>`;}}});});document.addEventListener('keydown',function(e){if(e.key==='Escape'){const activeSubmenu=document.querySelector('.nested.active');if(activeSubmenu){activeSubmenu.classList.remove('active');const parentSubmenu=activeSubmenu.parentNode.closest('.nested');if(parentSubmenu)parentSubmenu.classList.add('active');const parentMenu=activeSubmenu.closest('ul.drilldown');if(parentMenu)parentMenu.classList.remove('move-left');}}});});;
(function($,Drupal,once){Drupal.behaviors.hds_earthdata_header={attach:function(context,settings){once('earthdataStickyHeader','#page header#header',context).forEach(function(element){let isThrottled=false;let last_scroll_y=window.scrollY;let animation_frame;window.addEventListener('scroll',function(event){if(window.scrollY===0&&element.classList.contains('header-menu-scrolled')){if(animation_frame)cancelAnimationFrame(animation_frame);animation_frame=requestAnimationFrame(()=>{element.classList.remove('header-menu-scrolled');});}if(isThrottled)return;let current_scroll_y=window.scrollY;let rect=element.getBoundingClientRect();let sticky_top=parseInt(window.getComputedStyle(element).top,10);if(rect.top>sticky_top||current_scroll_y<=sticky_top){if(element.classList.contains('header-menu-scrolled')){if(animation_frame)cancelAnimationFrame(animation_frame);animation_frame=requestAnimationFrame(()=>{element.classList.remove('header-menu-scrolled');});}}else if(current_scroll_y>last_scroll_y){if(!element.classList.contains('header-menu-scrolled')){let dist=Math.abs(current_scroll_y-last_scroll_y);if(dist>25){if(animation_frame)cancelAnimationFrame(animation_frame);animation_frame=requestAnimationFrame(()=>{element.classList.add('header-menu-scrolled');});}}}else{if(current_scroll_y<last_scroll_y)if(element.classList.contains('header-menu-scrolled')){let dist=Math.abs(current_scroll_y-last_scroll_y);if(dist>10){if(animation_frame)cancelAnimationFrame(animation_frame);animation_frame=requestAnimationFrame(()=>{element.classList.remove('header-menu-scrolled');});}}}last_scroll_y=current_scroll_y<=0?0:current_scroll_y;isThrottled=true;setTimeout(function(){isThrottled=false;},200);});});}};})(jQuery,Drupal,once);;
var _ctct_m="ce804242c8b38c45142644251a0fed9a";(function($,Drupal,once){Drupal.behaviors.hds_earthdata_constant_contact_subscribe={attach:function(context,settings){once('constant-contact-subscribe','.ctct-inline-form',context).forEach(function(element){const other_cc_forms=[{'form':'arset','data-form-id':'b3ef5ed4-df1b-4afa-80c8-294f128b1816','ctctm':'1138736aed853fd1ea79ad644fce64f5'}];const data_form_id=element.getAttribute('data-form-id');other_cc_forms.forEach(function(other_form){if(other_form['data-form-id']===data_form_id)_ctct_m=other_form['ctctm'];});if(window.navigator.userAgent.includes("Firefox"))setTimeout(()=>{const form_container=element.querySelector(".ctct-form-container");const announce_block=element.parentNode.querySelector("#firefox-settings-announcement");const loading_spinner=element.parentNode.querySelector(".spinner-border");if(form_container&&announce_block){announce_block.classList.add("d-none");if(loading_spinner)loading_spinner.classList.add("d-none");}else{if(announce_block){announce_block.classList.remove("d-none");if(loading_spinner)loading_spinner.classList.add("d-none");if(typeof constantContactFormObserver!=='object'){const constantContactFormObserver=new MutationObserver(function(){announce_block.classList.add("d-none");constantContactFormObserver.disconnect();});constantContactFormObserver.observe(element,{subtree:true,childList:true});}}}},5000);else setTimeout(()=>{const loading_spinner=element.parentNode.querySelector(".spinner-border");if(loading_spinner)loading_spinner.classList.add("d-none");},5000);});}};})(jQuery,Drupal,once);;
