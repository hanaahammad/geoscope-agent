(function($,Drupal,once){"use strict";Drupal.behaviors.hds_earthdata={attach:function(context,settings){once("custom-reset-reload",".bef-exposed-form",context).forEach(function(form){if(form.id==="views-exposed-form-dataset-variables-json-block-1")return;const resetButton=form.querySelector('button[name="reset"]');if(resetButton)resetButton.addEventListener("click",function(e){e.preventDefault();e.stopImmediatePropagation();const baseUrl=window.location.href.split("?")[0].split("#")[0];window.location.href=baseUrl;return false;});});if($("#block-hds-earthdata-exposedformsearchpage-1").length)$(".views-exposed-form select").change(function(){$(this).parents("form").submit();});if($("article").hasClass("basic-page-hero-white-gradient"))$("#block-hds-earthdata-breadcrumbs").addClass("breadcrumb-black");else{if($("article").hasClass("basic-page-hero-black-gradient"))$("#block-hds-earthdata-breadcrumbs").addClass("breadcrumb-white");}once("bibtexButtonShow",'form[id^="views-exposed-form-publications"]',context).forEach(function(form){var bibtexBtn=form.querySelector(".bibtex-download-button");if(!bibtexBtn)return;bibtexBtn.style.display="";if(window.bootstrap&&window.bootstrap.Tooltip)new window.bootstrap.Tooltip(bibtexBtn);});once("bibtexButtonClick",".bibtex-download-button",context).forEach(function(bibtexBtn){bibtexBtn.addEventListener("click",function(){if(bibtexBtn.disabled)return;bibtexBtn.disabled=true;var params=new URLSearchParams();var displayId="default";var viewDom=bibtexBtn.closest(".views-element-container");if(viewDom&&drupalSettings.views&&drupalSettings.views.ajaxViews){var viewEl=viewDom.querySelector("[class*='js-view-dom-id-']");if(viewEl){var domIdMatch=viewEl.className.match(/js-view-dom-id-(\S+)/);if(domIdMatch){var viewSettings=drupalSettings.views.ajaxViews["views_dom_id:"+domIdMatch[1]];if(viewSettings){if(viewSettings.view_args)params.set("arg",viewSettings.view_args);if(viewSettings.view_name==="publications_solr"){var solrToDbDisplay={publications_all:"all_publications",publications_center_solr:"center_publications",publications_dataset_solr:"dataset_publications",publications_instrument_solr:"instrument_publications",publications_platform_solr:"platform_publications",publications_project_solr:"project_publications",publications_technique_solr:"technique_publications",publications_topic_solr:"topic_publications"};displayId=solrToDbDisplay[viewSettings.view_display_id]||"default";}else displayId=viewSettings.view_display_id||"default";}}}}params.set("display_id",displayId);var form=bibtexBtn.closest("form");if(form){var combineInput=form.querySelector('input[name="combine"]')||form.querySelector('input[name="search_fulltext"]');if(combineInput&&combineInput.value)params.set("combine",combineInput.value);}var token=Date.now()+"-"+Math.random().toString(36).slice(2,10);params.set("token",token);var btnSpan=bibtexBtn.querySelector("span");var pollStart=Date.now();btnSpan.textContent="Preparing 0s";bibtexBtn.classList.add("is-loading");var tickInterval=setInterval(function(){var secs=Math.floor((Date.now()-pollStart)/1000);btnSpan.textContent="Preparing "+secs+"s";},1000);function resetButton(){clearInterval(tickInterval);btnSpan.textContent="BibTeX";bibtexBtn.classList.remove("is-loading");bibtexBtn.disabled=false;}var pollInterval=setInterval(function(){if(document.cookie.indexOf("bibtex_download_token="+token)!==-1){clearInterval(pollInterval);document.cookie="bibtex_download_token=; path=/; expires=Thu, 01 Jan 1970 00:00:00 GMT";resetButton();}else{if(Date.now()-pollStart>120000){clearInterval(pollInterval);resetButton();}}},500);setTimeout(function(){window.location.href="/publications/bibtex-export?"+params.toString();},100);});});const copyUrlButtons=document.querySelectorAll(".copy-url-button");once("copyUrlButtons",copyUrlButtons).forEach((copyUrlButton)=>{copyUrlButton.addEventListener("click",function(e){const currentUrl=window.location.href;let alerted=false;navigator.clipboard.writeText(current